# Neon Postgres connection string.
# Neon dashboard -> your project -> Connect -> copy the "Connection string".
# Use the POOLED host (contains "-pooler") for the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Unpooled/direct host (no "-pooler"). Required for running migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Signing key for JWTs. Generate one: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV="development"

# OTP behaviour
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Jev (TypeSafe AI): the chat classifier ---
# Optional. Without a key the router falls back to a regex parser: the chat still
# works, it just reads the guest less well. `meta.routeMode` reports which ran.
TYPESAFE_API_KEY=""
TYPESAFE_BASE_URL="https://api.typesafe.ai"
JEV_MODEL="jev-latest"

# --- Mistral: the two prose paths only ---
# Used for the grounded dish answer and the advisory combo. Structured menu
# queries are pure SQL against Postgres and need no key at all.
# Also used by `bun run db:enrich`, which is what fills spice and taste tags.
MISTRAL_API_KEY=""
MISTRAL_CHAT_MODEL="ministral-8b-latest"
