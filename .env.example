# Neon Postgres connection string.
# Neon dashboard -> your project -> Connect -> copy the "Connection string".
# Use the POOLED host (contains "-pooler") for the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Unpooled/direct host (no "-pooler"). Required for running migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Signing key for JWTs. Generate one: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

PORT=3000
NODE_ENV="development"

# OTP behaviour
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
