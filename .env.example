# Neon Postgres connection string.
# Neon dashboard -> your project -> Connect -> copy the "Connection string".
# Use the POOLED host (contains "-pooler") for the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Unpooled/direct host (no "-pooler"). Required for running migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Signing key for JWTs. Generate one: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

PORT=3000
NODE_ENV="development"

# OTP behaviour
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Menu recommendations (POST /api/menu/recommend) ---
# Optional: without them the server still boots and only this route returns 503.
# Same values as rag/.env -- the rag/ project owns ingestion, this owns queries.
MISTRAL_API_KEY=""
MISTRAL_CHAT_MODEL="ministral-8b-latest"
MISTRAL_EMBED_MODEL="mistral-embed"

PINECONE_API_KEY=""
PINECONE_INDEX="milli-milli-menu"
PINECONE_NAMESPACE="items"
