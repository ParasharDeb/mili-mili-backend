// Prisma schema — https://pris.ly/d/prisma-schema
// Datasource URL is configured in prisma7.config.ts (reads DIRECT_URL).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SpicyEnum {
  very_spicy
  spicy
  not_spicy
  bland
  sweet
}

enum DietPrefEnum {
  Vegeterian
  Non_vegeterian
  Eggeterian
  OnlyFish
  Jain
}

enum CuisineEnum {
  Indian
  Asian
  Italian
  Continental
  Beverage
  Other
}

enum CourseEnum {
  Starter
  MainCourse
  Bread
  Salad
  Dessert
  Beverage
  Alcohol
  Shisha
  Sides
}

enum ProteinEnum {
  Chicken
  Mutton
  Fish
  Prawns
  Egg
  Paneer
  Tofu
  None
}

/// Admins sign in with email + bcrypt-hashed password.
model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

/// End users sign up / sign in with a phone number + OTP. They have no password.
model User {
  id              String       @id @default(uuid())
  phone           String       @unique
  name            String?
  phoneVerifiedAt DateTime?    @map("phone_verified_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  diet_preference DietPrefEnum
  otpCodes        OtpCode[]

  @@map("users")
}

/// A single issued OTP challenge. The code itself is never stored in plaintext.
model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, createdAt])
  @@index([userId])
  @@map("otp_codes")
}

model Item {
  id        String       @id @default(uuid())
  name      String
  desc      String?
  cuisine   CuisineEnum
  course    CourseEnum
  diet      DietPrefEnum
  allergens String?
  protein   ProteinEnum  @default(None)
  /// 0 (not spicy) to 5 (very spicy)
  spice     Int          @default(0)
  /// 0..1 confidence in `spice`. Null means never assessed — distinct from a
  /// confident 0, which the heuristic classifier could not express.
  spiceConfidence Float? @map("spice_confidence")
  tasteTags String[]     @map("taste_tags")
  serves    Int[]        @default([1])
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("items")
}

